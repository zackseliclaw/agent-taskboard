# Template rendered by install-service.sh; do not install this file directly.
[Unit]
Description=Local Agent Taskboard
Documentation=file:__PROJECT_ROOT__/README.md
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PYTHON__ __PROJECT_ROOT__/taskboard.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ReadWriteDirectories=__DATA_DIR__
ReadWriteDirectories=__ARTIFACTS_DIR__

[Install]
WantedBy=multi-user.target
